{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fintechbankx.example/tst/sample/created/v1",
  "title": "Test.Sample.Created.v1 data",
  "x-topic": "evt.tst.sample.created.v1",
  "type": "object",
  "required": [
    "sampleId",
    "amount",
    "channel"
  ],
  "properties": {
    "sampleId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED"
      ]
    },
    "note": {
      "type": "string"
    },
    "amount": {
      "$ref": "#/$defs/MonetaryAmount"
    },
    "channel": {
      "type": "string"
    }
  },
  "$defs": {
    "MonetaryAmount": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  }
}
