{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fintechbankx.example/pay/mandate/payment-accepted/v1",
  "title": "Payments.Mandate.PaymentAccepted.v1 data",
  "x-status": "Proposed",
  "x-topic": "evt.pay.mandate.v1",
  "x-event-type": "Payments.Mandate.PaymentAccepted.v1",
  "x-producer": "svc-pay-recurring-mandates",
  "x-envelope": "https://schemas.fintechbankx.example/common/event-envelope/v1",
  "x-source": "fintechbankx-governance-api-contracts-asyncapi-catalog asyncapi/svc-pay-recurring-mandates.yaml#/components/schemas/MandatePaymentAcceptedData",
  "type": "object",
  "description": "Payload of Payments.Mandate.PaymentAccepted.v1.",
  "additionalProperties": false,
  "properties": {
    "mandateId": {
      "type": "string",
      "minLength": 1
    },
    "paymentId": {
      "type": "string",
      "minLength": 1
    },
    "tppId": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "allOf": [
        {
          "$ref": "#/$defs/MonetaryAmount"
        }
      ],
      "description": "Accepted amount."
    },
    "periodKey": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "description": "Calendar month (YYYY-MM) in Asia/Dubai unless mandates.limit-period-zone says otherwise."
    },
    "periodTotal": {
      "allOf": [
        {
          "$ref": "#/$defs/MonetaryAmount"
        }
      ],
      "description": "Accepted total for periodKey including this payment."
    }
  },
  "required": [
    "mandateId",
    "paymentId",
    "tppId",
    "amount",
    "periodKey",
    "periodTotal"
  ],
  "$defs": {
    "MonetaryAmount": {
      "type": "object",
      "description": "Money value. Amount is a decimal string to avoid binary floating point rounding.",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "examples": [
            "25000.00"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code.",
          "examples": [
            "AED"
          ]
        }
      }
    }
  }
}
