{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fintechbankx.example/ln/loan/disbursed/v1",
  "title": "Lending.Loan.Disbursed.v1 data",
  "x-status": "Proposed",
  "x-topic": "evt.ln.loan.v1",
  "x-event-type": "Lending.Loan.Disbursed.v1",
  "x-producer": "svc-ln-loan-lifecycle",
  "x-envelope": "https://schemas.fintechbankx.example/common/event-envelope/v1",
  "x-source": "fintechbankx-governance-api-contracts-asyncapi-catalog asyncapi/svc-ln-loan-lifecycle.yaml#/components/schemas/LoanDisbursedData",
  "type": "object",
  "description": "Payload of Lending.Loan.Disbursed.v1.",
  "properties": {
    "loanId": {
      "type": "string",
      "description": "Loan id.",
      "minLength": 1
    },
    "customerId": {
      "type": "string",
      "description": "Customer id.",
      "minLength": 1
    },
    "principalAmount": {
      "allOf": [
        {
          "$ref": "#/$defs/MonetaryAmount"
        }
      ],
      "description": "Disbursed principal."
    },
    "disbursementDate": {
      "type": "string",
      "description": "Disbursement value date.",
      "format": "date"
    }
  },
  "required": [
    "loanId",
    "customerId",
    "principalAmount",
    "disbursementDate"
  ],
  "$defs": {
    "MonetaryAmount": {
      "type": "object",
      "description": "Money value. Amount is a decimal string to avoid binary floating point rounding.",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "examples": [
            "25000.00"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code.",
          "examples": [
            "AED"
          ]
        }
      }
    }
  }
}
